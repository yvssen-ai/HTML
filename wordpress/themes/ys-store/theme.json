{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "880px",
			"wideSize": "1320px"
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "void", "color": "#05060a", "name": "Void" },
				{ "slug": "deep", "color": "#0b0e1a", "name": "Deep" },
				{ "slug": "panel", "color": "#0e1119", "name": "Panel" },
				{ "slug": "ink", "color": "#f2f5ff", "name": "Ink" },
				{ "slug": "ink-dim", "color": "#98a0b8", "name": "Ink dim" },
				{ "slug": "cyan", "color": "#00e5ff", "name": "Cyan" },
				{ "slug": "violet", "color": "#8b5cf6", "name": "Violet" },
				{ "slug": "pink", "color": "#ff3d81", "name": "Pink" },
				{ "slug": "lime", "color": "#c8ff2f", "name": "Lime" },
				{ "slug": "paper", "color": "#f1efe9", "name": "Paper" }
			],
			"gradients": [
				{
					"slug": "brand",
					"name": "Brand ramp",
					"gradient": "linear-gradient(120deg, #00e5ff 0%, #8b5cf6 55%, #ff3d81 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "Syne, 'Trebuchet MS', system-ui, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Space Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.88rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{
					"slug": "large",
					"name": "Large",
					"size": "1.35rem",
					"fluid": { "min": "1.1rem", "max": "1.35rem" }
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "3.2rem",
					"fluid": { "min": "1.9rem", "max": "3.2rem" }
				}
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--void)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.62"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--cyan)" }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "0.98",
					"letterSpacing": "-0.03em"
				}
			}
		}
	}
}
